# TopGun Configuration
# Copy to .env and modify as needed
# Run: cp .env.example .env

# =============================================================================
# STORAGE
# =============================================================================

# Storage backend: redb | null
# - redb: embedded store (default). Data survives restarts.
# - null: no durable store (data lost on restart, for testing)
STORAGE_BACKEND=redb

# Where the store directory and the write-ahead log live. Keep both on the
# same persistent volume. TOPGUN_DATA_DIR defaults to topgun-data beside
# TOPGUN_REDB_PATH (or ./topgun-data when neither is set). TOPGUN_REDB_PATH
# names only the store file of earlier versions, which the server migrates into
# the store directory once and keeps as {path}.pre-migration; a small marker
# file then stays at that path. Do not delete it while an older server binary
# may be started with this configuration.
# TOPGUN_DATA_DIR=./data/topgun-data
# TOPGUN_REDB_PATH=./data/topgun.redb
# TOPGUN_WAL_DIR=./data/topgun-wal

# =============================================================================
# SERVER
# =============================================================================

# Main server port (WebSocket + HTTP)
PORT=8080

# Metrics endpoint port (Prometheus format)
METRICS_PORT=9091

# Node ID (auto-generated UUID if not set)
# NODE_ID=node-1

# =============================================================================
# CLUSTER (optional)
# =============================================================================

# Clustering is configured via Docker Compose using the 'cluster' profile.
# Run: docker compose --profile cluster up -d
# See docker-compose.yml for cluster node configuration.

# =============================================================================
# AUTH (optional)
# =============================================================================

# JWT secret for authentication
# JWT_SECRET=your-secret-key-min-32-chars-long

# JWT token expiration
# JWT_EXPIRY=24h

# =============================================================================
# ADMIN (optional)
# =============================================================================

# Admin UI credentials
# TOPGUN_ADMIN_USERNAME=admin
# TOPGUN_ADMIN_PASSWORD=changeme

# Path to admin SPA build output
# TOPGUN_ADMIN_DIR=./admin/dist

# =============================================================================
# LOGGING (optional)
# =============================================================================

# Log format: json or omit for human-readable output
# TOPGUN_LOG_FORMAT=json

# Log level: fatal, error, warn, info, debug, trace
# LOG_LEVEL=info
